# The API server. Retell-only deployments leave every LIVEKIT_* value unset.
# R2_* are optional: set all four to record calls, or none.
DATABASE_URL=
# Maximum PostgreSQL connections per process; default 3.
DATABASE_POOL_MAX=3
# Optional legacy LiveKit browser/handoff paths; set all three or none.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required only for connecting Google Calendar; same OAuth client as Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra web application. Supports organizational and personal accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Slack app OAuth credentials. The bot token is encrypted in PostgreSQL after install.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# 32 random bytes as 64 hex characters. Keep the same key in API and voice.
TOKEN_ENCRYPTION_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
PORT=
DASHBOARD_ORIGINS=
# Public origin of this API, without /api. Its provider callback URIs must match exactly.
PUBLIC_API_URL=http://localhost:8080
# Optional, server-only webhook-badged Retell key. Never use a VITE variable.
RETELL_API_KEY=

# Operator-approved Retell binding (server only)
# RETELL_WORKSPACE_ID=
# RETELL_AGENT_ID=

# Cal.com v2. API keys are entered per employee and encrypted with TOKEN_ENCRYPTION_KEY.
# Exact production API only; self-hosted origins are not supported.
CALCOM_API_BASE_URL=https://api.cal.com/v2
# Hosted confidential client registered at https://app.cal.com/settings/developer/oauth.
# Exact callback: PUBLIC_API_URL + /api/calcom/oauth/callback. Server-only; never use VITE_*.
CALCOM_OAUTH_CLIENT_ID=
CALCOM_OAUTH_CLIENT_SECRET=
# Fail closed by default. Set true only after Cal.com explicitly approves the hosted client's event-type/webhook writes.
CALCOM_OAUTH_WRITE_APPROVED=false
# Server-only random root (at least 32 characters). DeskRoute derives one secret per Cal webhook; never enter this root in Cal.com.
CALCOM_WEBHOOK_SECRET=

# Server-only random secret (32+ characters) for the daily receipt retention scheduler.
CRON_SECRET=
