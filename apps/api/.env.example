# The API server. DATABASE_URL through R2_* are shared with apps/voice.
# R2_* are optional: set all four to record calls, or none.
DATABASE_URL=
# Maximum PostgreSQL connections per process; default 3.
DATABASE_POOL_MAX=3
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required only for connecting Google Calendar; same OAuth client as Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra web application. Supports organizational and personal accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Slack app OAuth credentials. The bot token is encrypted in PostgreSQL after install.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# 32 random bytes as 64 hex characters. Keep the same key in API and voice.
TOKEN_ENCRYPTION_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
PORT=
DASHBOARD_ORIGINS=
# Public origin of this API, without /api. Must match the Google redirect URI.
PUBLIC_API_URL=http://localhost:8080
