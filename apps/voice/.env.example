# The LiveKit worker. DATABASE_URL through R2_* are shared with apps/api.
# OPENROUTER_* are required when LLM_PROVIDER is openrouter.
DATABASE_URL=
# Maximum PostgreSQL connections per process; default 3.
DATABASE_POOL_MAX=3
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required only for connecting Google Calendar; same OAuth client as Supabase.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# 32 random bytes as 64 hex characters. Keep the same key in API and voice.
TOKEN_ENCRYPTION_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
LLM_PROVIDER=
LLM_MODEL=
SUMMARY_LLM_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
